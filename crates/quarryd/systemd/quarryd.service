[Unit]
Description=quarryd node agent
Wants=network-online.target
After=network-online.target systemd-networkd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/quarryd run --config /etc/quarryd/quarryd.toml
Restart=always
RestartSec=2
KillMode=process
TimeoutStopSec=30
Delegate=no
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
# LVM writes metadata archives/backups under /etc/lvm and locks under /run.
ReadWritePaths=/var/lib/quarryd /run /etc/lvm /srv/jailer /usr/local/bin /dev/net/tun /sys/fs/cgroup
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_SYS_CHROOT CAP_MKNOD CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_KILL CAP_SYS_PTRACE CAP_NET_RAW
AmbientCapabilities=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
